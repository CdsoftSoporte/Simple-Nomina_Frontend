@attribute [Authorize]
@page "/calculo_aguinaldos"
@using FrontEndSN.Clases
@using FrontEndSN.Components.Reutilizables
@using FrontEndSN.Components.Modales
@inherits VentanaBase;
<PageTitle>Cálculo Masivo de Aguinaldo</PageTitle>

<div class="dashboard-container page-header-fade fade-in-all">
    <FlechaRegresoMenu Titulo="Cálculo de aguinaldos"
                       Subtitulo="Calcula aguinaldos de manera masiva"
                       RutaRegresar="/menu_calculo_nomina"
                       Cargando="cargando" />


    @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center p-5">
            <div class="text-center">
                <div class="spinner-custom mb-3"></div>
                <p class="text-muted">Espere por favor...</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 tarjeta-flotante">
            <div class="card-body" style="display: flex; flex-direction: row; justify-content:space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">

                <div style="display:flex; justify-content:space-between; align-items:center;width:100%;">
                    <div style="width: 350px; padding:5px;">

                        <label class="form-label">Registro patronal:</label>
                        <DxComboBox Data="@ListaPatrones" ValueFieldName="id" TextFieldName="razon_social"
                                    Value="@IdPatronSeleccionado"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    NullText="Seleccione un registro patronal"
                                    ShowDropDownButton="false"
                                    ValueChanged="(int newValue) => OnRegistroPatronalChanged(newValue)">

                            <Buttons>
                                <!-- Esto mueve el botón por defecto hacia la izquierda -->
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>

                        </DxComboBox>
                    </div>

                    <div style="width: 250px; padding:5px;">
                        <label class="form-label">Nómina:</label>

                        <DxComboBox Data="@ListaNominas" ValueFieldName="Id" TextFieldName="DescripcionCompleta"
                                    Value="@IdNominaSeleccionada"
                                    ShowDropDownButton="false"
                                    NullText="Seleccione una nómina"
                                    ValueChanged="(int newValue)=>OnNominaChanged(newValue)">

                            <Buttons>
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>

                        </DxComboBox>
                    </div>

                    <div style="width: 250px; padding:5px;">
                        <label class="form-label">Centro de Ctos.:</label>

                        <DxComboBox Data="@ListaCentros" ValueFieldName="Id" TextFieldName="NombreCompleto"
                                    Value="@IdCentroDeCostosSeleccionado"
                                    ShowDropDownButton="false"
                                    ValueChanged="(int newValue)=>OnCentroCostosChanged(newValue)">

                            <Buttons>
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>

                        </DxComboBox>
                    </div>
                </div>

                <div style="width:100%;display:flex;justify-content:center;align-content:center;gap:2rem;">

                    <DxCheckBox @bind-Checked="@Considerar360Dias" @bind-Checked:after="LimpiarGrid">
                        Considerar 360 días de cálculo
                    </DxCheckBox>

                    <DxCheckBox @bind-Checked="@TomarDiasSinCalcular" @bind-Checked:after="LimpiarGrid">
                        Considerar días sin acumular como asistencia
                    </DxCheckBox>

                    <DxCheckBox @bind-Checked="@ConsiderarFaltas" @bind-Checked:after="LimpiarGrid">
                        Considerar faltas en cálculo de días a pagar
                    </DxCheckBox>

                </div>

                <div style=" width:100%;display: flex; flex-direction: row;justify-content:end;align-items:center; gap: 0.5rem;padding-top:8px;padding-bottom:1px;padding-right:5px;">
                    <DxButton Text="Generar Cálculo de Aguinaldo" Enabled="@(IdNominaSeleccionada > 0)" 
                        IconCssClass="bi bi-search" RenderStyle="ButtonRenderStyle.Primary" Click="CargarDatosAguinaldo" />
                    
                    <DxButton Text="Exportar a Excel" Enabled="@(ListaAguinaldos?.Count > 0)" 
                        IconCssClass="bi bi-file-earmark-bar-graph" RenderStyle="ButtonRenderStyle.Success" Click="DescargarExcel" />

                    <DxButton Text="Generar Incidencias" Enabled="@(IdNominaSeleccionada > 0 && ListaAguinaldos.Count > 0)"
                              IconCssClass="bi bi-file-earmark-check-fill" CssClass="@(IdNominaSeleccionada > 0 && ListaAguinaldos.Count>0?"btn-purple":"")"
                              Click="MostrarModal" />
                </div>

            </div>
        </div>

        <br />

        <div class="card shadow-sm border-0">
            <div class="card-body"style="justify-content:center;">


                <DxGrid Data="@ListaAguinaldos"
                        ShowFilterRow="false"
                        ShowSearchBox="true"
                        SearchBoxNullText="Buscar empleado..."
                        CustomizeElement="Grid_CustomizeElement"
                        PageSize="15"
                        HighlightRowOnHover="true"
                        style="width:105%;">
                    <Columns>

                        <DxGridDataColumn FieldName="NombreEmpleado" Caption="Empleado" TextAlignment="GridTextAlignment.Left" />
                        <DxGridDataColumn FieldName="UltimaAlta" Caption="Ultima Alta / Reing." Width="100px" DisplayFormat="dd/MM/yyyy" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="UltimoMov" Caption="Ultima Modif. Sal." Width="100px" DisplayFormat="dd/MM/yyyy" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="Diario" Caption="Sueldo Diario" Width="80px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="DiasAguinaldo" Caption="Dias de Aguinaldo" Width="85px"TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="DiasTrabajados" Caption="Dias Trabajados" Width="85px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="Faltas" Caption="Faltas" Width="70px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="DiasNetos" Caption="Dias Netos" Width="80px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="DiasProporcionales" Caption="Prop. Días" Width="80px"TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="AguinaldoAnterior" Caption="Aguinaldo otorgado anteriormente" Width="110px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="AguinaldoAPagar" Caption="Aguinaldo restante por pagar" Width="100px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="ImporteIsrAguinaldo" Caption="ISR a aplicar" Width="100px" TextAlignment="GridTextAlignment.Center" />
                    </Columns>

                    <EmptyDataAreaTemplate>
                        <div class="empty-grid-container">
                            <div class="empty-icon-wrapper">
                                <i class="bi bi-cash-stack"></i>
                            </div>
                            <h4>Sin registros encontrados</h4>
                        </div>
                    </EmptyDataAreaTemplate>

                </DxGrid>
            </div>
        </div>
      
    }
</div>
    @* Modal para Agregar/Editar *@
    <DxWindow @bind-Visible="@isModalVisible"
          HeaderText="Seleccione periodo para cargar incidencias"
          Width="550px"
          AllowResize="false"
          ShowCloseButton="true"
          CloseOnEscape="true"
          HeaderCssClass="bg-primary text-white"
          FooterText=""
          Modal="true">
          <BodyTextTemplate>
            <div class="p-2">
                <div style="width: 390px; padding:5px;">
                    <label class="form-label fw-bold">Periodo</label>
                    <DxComboBox Data="@ListaPeriodos" ValueFieldName="id" TextFieldName="Descripcion"
                            Value="@IdPeriodoSeleccionado"
                            ShowDropDownButton="false"
                            NullText="Seleccione un periodo"
                            ValueChanged="(int newValue) => OnPeriodoChanged(newValue)">

                        <Buttons>
                            <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                        </Buttons>

                    </DxComboBox>
                </div>
                <div style="margin-top:10px">
                    <DxButton Text="Cancelar" Click="() => isModalVisible = false" RenderStyle="ButtonRenderStyle.Secondary" />
                <DxButton IconCssClass="bi-check-circle-fill" Enabled="@(IdPeriodoSeleccionado>0)" Text="Cargar Incidencias" Click="GuardarIncidenciasAguinaldo" RenderStyle="ButtonRenderStyle.Primary" />
                </div>
            </div>
        </BodyTextTemplate>
    </DxWindow>
