@attribute [Authorize]
@page "/generar_archivos_sua"
@using FrontEndSN.Clases
@using FrontEndSN.Components.Reutilizables
@using FrontEndSN.Components.Modales
@inherits VentanaBase;
<PageTitle>Generador archivos SUA</PageTitle>

<div class="dashboard-container page-header-fade fade-in-all">
     <FlechaRegresoMenu Titulo="Generador de archivos para SUA"
                       Subtitulo="Generar archivo de importación de movimientos para SUA"
                       RutaRegresar="/menu_especiales"
                       Cargando="cargando" /> 

     @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center p-5">
            <div class="text-center">
                <div class="spinner-custom mb-3"></div>
                <p class="text-muted">Espere por favor...</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-3 mb-4 tarjeta-flotante">
            <div class="card-body">

                <DxFormLayout>
                    <!-- ================= RENGLÓN 1 ================= -->
                    <!-- Registro Patronal (5 columnas de 12) -->
                    <DxFormLayoutItem Caption="Registro patronal:" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="5">
                        <DxComboBox Data="@ListaPatrones" ValueFieldName="id" TextFieldName="razon_social"
                                    Value="@IdPatronSeleccionado"
                                    SearchMode="ListSearchMode.AutoSearch"
                                    NullText="Seleccione un registro patronal"
                                    ValueChanged="(int newValue) => OnRegistroPatronalChanged(newValue)"
                                    ShowDropDownButton="false">
                            <Buttons>
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>
                        </DxComboBox>
                    </DxFormLayoutItem>

                    <!-- Movimiento (3 columnas de 12) -->
                    <DxFormLayoutItem Caption="Movimiento:" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="3">
                        <DxComboBox Data="@ListaMovimientos" ValueFieldName="Valor" TextFieldName="Texto"
                                    Value="@MovimientoSeleccionado"
                                    ShowDropDownButton="false"
                                    ValueChanged="(char newValue) => OnMovimientoChanged(newValue)">
                            <Buttons>
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>
                        </DxComboBox>
                    </DxFormLayoutItem>

                    <!-- Empleado (4 columnas de 12) -->
                    <DxFormLayoutItem Caption="Empleado:" CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                        <DxComboBox Data="@ListaEmpleados" ValueFieldName="Id" TextFieldName="NombreCompleto"
                                    Value="@IdEmpleadoSeleccionado"
                                    ShowDropDownButton="false"
                                    ValueChanged="(int newValue) => OnEmpleadoChanged(newValue)">
                            <Buttons>
                                <DxComboBoxDropDownButton Position="EditorButtonPosition.Left" />
                            </Buttons>
                        </DxComboBox>
                    </DxFormLayoutItem>

                    <!-- ================= RENGLÓN 2 ================= -->
                    <!-- Desde (2 columnas de 12) -->
                    <DxFormLayoutItem Caption="Desde:" CaptionPosition="CaptionPosition.Vertical" ColSpanxs="4" ColSpanMd="2">
                        <DxDateEdit @bind-Date="FechaDesdeConsulta"
                                    @bind-Date:after="LimpiarGrid"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>

                    <!-- Hasta (2 columnas de 12) -->
                    <DxFormLayoutItem Caption="Hasta:" CaptionPosition="CaptionPosition.Vertical" ColSpanxs="4" ColSpanMd="2">
                        <DxDateEdit @bind-Date="FechaHastaConsulta"
                                    @bind-Date:after="LimpiarGrid"
                                    ClearButtonDisplayMode="DataEditorClearButtonDisplayMode.Auto" />
                    </DxFormLayoutItem>
                    

                    <!-- Botones (8 columnas de 12) -->
                    <DxFormLayoutItem ColSpanMd="8">

                        <CaptionTemplate><span style="visibility: hidden;">Botones</span></CaptionTemplate>

                        <Template>
                            <div style="width: 100%; display: flex; justify-content: flex-end; gap: 0.5rem;">

                                <DxButton Text="Buscar Movimientos" Click="ConsultarMovimientos"
                                          IconCssClass="bi bi-search" Enabled="@(IdPatronSeleccionado > 0)"
                                          RenderStyle="ButtonRenderStyle.Primary" />

                                <DxButton Text="Exportar a Excel" Enabled="@(ListaMovimientosSUA?.Count > 0)"
                                          IconCssClass="bi bi-file-earmark-bar-graph" RenderStyle="ButtonRenderStyle.Success"
                                          Click="DescargarExcel" />

                                <DxButton Text="Generar Archivos TXT" Enabled="@(ListaMovimientosSUA?.Count > 0)"
                                          IconCssClass="bi bi-file-earmark-check-fill" CssClass="@(ListaMovimientosSUA?.Count > 0 ? "btn-purple" : "")"
                                          Click="GenerarMovimientos" />

                            </div>
                        </Template>
                    </DxFormLayoutItem>
                </DxFormLayout>
            </div>
        </div>

        <br />

        <div class="card shadow-sm border-0">
            <div class="card-body" style="justify-content:center;">


                <DxGrid Data="@ListaMovimientosSUA"
                        ShowFilterRow="false"
                        ShowSearchBox="true"
                        SearchBoxNullText="Buscar empleado..."
                        CustomizeElement="Grid_CustomizeElement"
                        PageSize="10"
                        HighlightRowOnHover="true"
                        style="height:500px"
                        >
                    <Columns>

                        <DxGridDataColumn FieldName="Nombre" Caption="Empleado" TextAlignment="GridTextAlignment.Left" />
                        <DxGridDataColumn FieldName="Nss" Caption="Núm. Seg. Social" Width="140px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="Integrado" Caption="Diario Integrado" Width="100px" TextAlignment="GridTextAlignment.Center">
                    
                            <CellDisplayTemplate>
                            @{
                                // Convertimos el contexto al tipo de tu clase DTO
                                var registro = (ListaMovimientosSUADTO)context.DataItem;

                                if (registro.Integrado == 0)
                                {
                                    <span class="text-muted">N/A</span>
                                }
                                else
                                {
                                    // Le damos formato de moneda
                                    <span>@registro.Integrado.ToString("c2")</span>
                                }
                            }
                            </CellDisplayTemplate>

                        </DxGridDataColumn>

                        <DxGridDataColumn FieldName="TipoMov" Caption="Tipo Mov." Width="85px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="Fecha" Caption="Fecha Mov." DisplayFormat="dd/MM/yyyy" Width="110px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="FolioIncapacidad" Caption="Folio Incapacidad" Width="110px" TextAlignment="GridTextAlignment.Center" />
                        <DxGridDataColumn FieldName="DiasIncidencia" Caption="Días Incidencia" Width="100px" TextAlignment="GridTextAlignment.Center">

                            <CellDisplayTemplate>
                                @{
                                    // Convertimos el contexto al tipo de tu clase DTO
                                    var registro = (ListaMovimientosSUADTO)context.DataItem;

                                    if (registro.DiasIncidencia == 0)
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                    else
                                    {
                                        // Le damos formato de moneda
                                        <span>@registro.DiasIncidencia</span>
                                    }
                                }
                            </CellDisplayTemplate>
   
                        </DxGridDataColumn>
                        
                    </Columns>

                    <EmptyDataAreaTemplate>
                        <div class="empty-grid-container">
                            <div class="empty-icon-wrapper">
                                <i class="bi bi-universal-access"></i>
                            </div>
                            <h4>Sin registros encontrados</h4>
                        </div>
                    </EmptyDataAreaTemplate>

                </DxGrid>
            </div>
        </div>



    }
 
</div>