@attribute [Authorize]
@page "/configuracion_empresa"
@using DevExpress.Blazor
@using FrontEndSN.Components.Reutilizables
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@rendermode InteractiveServer
<PageTitle>Configuración de la empresa</PageTitle>

<div class="dashboard-container page-header-fade fade-in-all">


    <FlechaRegresoMenu Titulo="Configuración de Empresa" 
        Subtitulo="Datos generales, dirección fiscal y configuración SAT/CFDI"
        RutaRegresar="/menu_configuracion"
        Cargando="cargando" />

    @if (cargando)
    {
        <div class="d-flex justify-content-center align-items-center p-5">
            <div class="text-center">
                <div class="spinner-custom mb-3"></div>
                <p class="text-muted">Cargando empleados...</p>
            </div>
        </div>
    }
    else
    {
        <EditForm EditContext="@editContext" Context="formContext">
            <DataAnnotationsValidator />

            <DxTabs>
                <DxTabPage TabIconCssClass="bi bi-building me-2" Text="Datos Generales">
                    @* ── SECCIÓN 1: Datos Generales ── *@
                    <div class="card shadow-sm border-0 p-0 fade-in-all overflow-hidden mb-4">
                        
                        <div class="p-4">
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-bold">Razón Social:</label>
                                    <DxTextBox @bind-Text="@Modelo.RazonSocial"
                                        NullText="Ej. Mi Empresa S.A. de C.V."
                                        CssClass="custom-input" />
                                    <ValidationMessage For="@(() => Modelo.RazonSocial)" />
                                </div>
                                <div class="col-md-4">
                                    <div class="div25por">
                                        <label class="form-label fw-bold">RFC:</label>
                                        <DxTextBox @bind-Text="@Modelo.Rfc"
                                        NullText="Ej. MEM920101ABC"
                                        CssClass="custom-input"
                                        />
                                        <ValidationMessage For="@(() => Modelo.Rfc)" />
                                    </div>
                                </div>

                                @* Logo *@
                                <div class="col-md-8">
                                    <label class="form-label fw-bold">Logo de la Empresa:</label>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(logoBase64))
                                        {
                                            <img src="@logoBase64" alt="Logo"
                                            style="height:60px; object-fit:contain; border-radius:8px;" />
                                        }
                                        <div>
                                            <InputFile OnChange="@((e) => SubirArchivo(e, "logo"))"
                                               accept=".png,.jpg,.jpeg"
                                               class="form-control custom-input" />
                                            @if (!string.IsNullOrEmpty(Modelo.LogoNombre))
                                            {
                                                <small class="text-muted">
                                                    <i class="bi bi-image me-1"></i>@Modelo.LogoNombre
                                                </small>
                                            }
                                        </div>
                                    </div>
                                    @if (subiendoLogo)
                                    {
                                        <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Subiendo...</small>
                                    }
                                </div>

                                <div class="col-md-4"style="width:15% !important;">
                                    <label class="form-label fw-bold small">Tipo de Empresa:</label>
                                    <DxComboBox Data="@TipoEmpresaOpciones" @bind-Value="@Modelo.TipoEmpresa"
                                                TextFieldName="Texto" ValueFieldName="Valor"
                                                SearchMode="@ListSearchMode.AutoSearch"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </DxTabPage>

                <DxTabPage TabIconCssClass="bi bi-geo-alt me-2" Text="Dirección Fiscal">
                    @* ── SECCIÓN 2: Dirección Fiscal ── *@
                    <div class="card shadow-sm border-0 p-0 fade-in-all overflow-hidden mb-4">
                        <div class="p-4">
                            <div class="row g-3">
                                <div class="div30por">
                                    <label class="form-label fw-bold">Calle:</label>
                                    <DxTextBox @bind-Text="@Modelo.Calle"
                                        NullText="Ej. Av. Insurgentes Sur"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">No. Exterior:</label>
                                    <DxTextBox @bind-Text="@Modelo.NumeroExterior"
                                        NullText="Ej. 123"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">No. Interior:</label>
                                    <DxTextBox @bind-Text="@Modelo.NumeroInterior"
                                        NullText="Ej. A"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">Colonia:</label>
                                    <DxTextBox @bind-Text="@Modelo.Colonia"
                                        NullText="Ej. Del Valle"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">Municipio/Alcaldía:</label>
                                    <DxTextBox @bind-Text="@Modelo.Municipio"
                                        NullText="Ej. Benito Juárez"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">C.P.:</label>
                                    <DxTextBox @bind-Text="@Modelo.CodigoPostal"
                                        NullText="Ej. 03100"
                                        CssClass="custom-input" />
                                </div>
                                <div class="div30por">
                                    <label class="form-label fw-bold">Estado:</label>
                                    <DxTextBox @bind-Text="@Modelo.Estado"
                                        NullText="Ej. CDMX"
                                        CssClass="custom-input" />
                                </div>
                            </div>
                        </div>
                    </div>
                </DxTabPage>

                <DxTabPage TabIconCssClass="bi bi-shield-lock me-2" Text="Datos de Timbrado">
                    @* ── SECCIÓN 3: SAT / CFDI ── *@
                    <div class="card shadow-sm border-0 p-0 fade-in-all overflow-hidden mb-4">
                        <div class="p-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Certificado CSD (.cer):</label>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(Modelo.CerNombre))
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Cargado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle me-1"></i>Sin archivo</span>
                                        }
                                        <InputFile OnChange="@((e) => SubirArchivo(e, "cer"))"
                                            accept=".cer"
                                            class="form-control custom-input" />
                                    </div>
                                    @if (subiendoCer)
                                    {
                                        <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Subiendo...</small>
                                    }
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Llave Privada (.key):</label>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(Modelo.KeyNombre))
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Cargado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle me-1"></i>Sin archivo</span>
                                        }
                                        <InputFile OnChange="@((e) => SubirArchivo(e, "key"))"
                                            accept=".key"
                                            class="form-control custom-input" />
                                    </div>
                                    @if (subiendoKey)
                                    {
                                        <small class="text-muted"><i class="bi bi-arrow-repeat"></i> Subiendo...</small>
                                    }
                                </div>

                                <div class="col-md-4">
                                    <div style="width:25%!important;">
                                    <label class="form-label fw-bold">Contraseña del Certificado:</label>
                                    <DxTextBox @bind-Text="@Modelo.CerPassword"
                                        Password="true"
                                        NullText="Contraseña del CSD"
                                        CssClass="custom-input" />
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <DxCheckBox @bind-Checked="Modelo.TimbradoPruebaBool"
                                                CssClass="fw-bold text-primary">Timbrado de prueba</DxCheckBox>

                                </div>

                            </div>
                        </div>
                    </div>
                </DxTabPage>
                @* ── Datos de contacto y configuración de correo para envio de recibos de nómina ── *@
                <DxTabPage TabIconCssClass="bi bi-chat-dots" Text="Contacto y envío por correo">
                    <div class="card shadow-sm border-0 p-0 fade-in-all overflow-hidden mb-4">
                        
                        <div class="p-4">
                           
                            <div style="width:90%;display:flex; flex-direction:row;justify-content:start;gap:1rem;align-items:center;padding:5px;">
                                <div style="width:35% !important;">
                                        <label class="form-label fw-bold">Correo Electrónico para envío de recibos:</label>
                                        <DxTextBox @bind-Text="@Modelo.Correo"
                                               NullText="Ej. empresa@dominio.com"
                                               CssClass="custom-input"/>
                                        <ValidationMessage For="@(() => Modelo.Correo)" />
                                </div>
                                <div style="width:35% !important">
                                    <label class="form-label fw-bold">Contraseña:</label>
                                    <DxTextBox @bind-Text="@Modelo.Correo"
                                               NullText="Ingrese su contraseña"
                                               CssClass="custom-input"
                                               Password="true"/>
                                    <ValidationMessage For="@(() => Modelo.Correo)" />
                               
                                </div>
                                <div style="width:30% !important;padding-top:20px;">
                                    <DxCheckBox @bind-Checked="Modelo.EnviarCorreosBool"
                                                CssClass="fw-bold text-primary">Envío automático de recibos al timbrar</DxCheckBox>

                                </div>
                            </div>
                        </div>
                    </div>
                </DxTabPage>

            </DxTabs>

            @* ── Botón Guardar ── *@
            <div class="d-flex justify-content-end mt-2 mb-4 p-4">
                <DxButton Text="Guardar Configuración"
                      Click="Guardar"
                      RenderStyle="ButtonRenderStyle.Success"
                      CssClass="btn-save-all shadow"
                      IconCssClass="bi bi-check2-circle" />
            </div>
        </EditForm>
    }   
</div>
