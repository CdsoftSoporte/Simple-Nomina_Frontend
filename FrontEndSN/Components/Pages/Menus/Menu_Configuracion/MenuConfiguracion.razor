@attribute [Authorize]
@page "/menu_configuracion"
@using FrontEndSN.Components.Reutilizables
@using Microsoft.AspNetCore.Authorization
@using System.IdentityModel.Tokens.Jwt
@using Microsoft.AspNetCore.Components.Authorization
@using DevExpress.Blazor
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav
<PageTitle>Menú de configuración</PageTitle>

<div class="dashboard-container page-header-fade fade-in-all">

    <FlechaRegresoMenu Titulo="Menú de configuración" 
        Subtitulo="Administración de datos de la empresa, cuenta de usuario, etc."
        RutaRegresar="/dashboard"
        Cargando="false" />

    <div class="dashboard-grid">
        @foreach (var cat in listaConfiguraciones)
        {
            <div class="card catalog-item" @onclick="() => Nav.NavigateTo(cat.Ruta)">
                <div class="card-icon" style="color: @cat.Color">
                    <i class="@cat.Icono"></i>
                </div>
                <div class="card-content">
                    <h3>@cat.Titulo</h3>
                    <p>@cat.Descripcion</p>
                </div>
            </div>
        }
    </div>
</div>